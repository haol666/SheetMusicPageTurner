<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="21507" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="ScoreImportVC">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="21505"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="System colors in document resources" minToolsVersion="11.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--Score Import View Controller-->
        <scene sceneID="ScoreImport">
            <objects>
                <viewController id="ScoreImportVC" customClass="ScoreImportViewController" customModule="SheetMusicPageTurner" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="ScoreImportView">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <viewLayoutGuide key="safeArea" id="ScoreImportSafe"/>
                        <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                    </view>
                    <navigationItem key="navigationItem" title="琴谱管理" id="ScoreImportNav"/>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="ScoreImportFirst" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="134" y="103"/>
        </scene>
        <!--Score Display View Controller-->
        <scene sceneID="ScoreDisplay">
            <objects>
                <viewController id="ScoreDisplayVC" customClass="ScoreDisplayViewController" customModule="SheetMusicPageTurner" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="ScoreDisplayView">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <viewLayoutGuide key="safeArea" id="ScoreDisplaySafe"/>
                        <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                    </view>
                    <navigationItem key="navigationItem" id="ScoreDisplayNav"/>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="ScoreDisplayFirst" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="768" y="103"/>
        </scene>
        <!--View Controller-->
        <scene sceneID="FaceRecognize">
            <objects>
                <viewController id="FaceRecognizeVC" customClass="ViewController" customModule="SheetMusicPageTurner" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="FaceRecognizeView">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <viewLayoutGuide key="safeArea" id="FaceRecognizeSafe"/>
                        <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                    </view>
                    <navigationItem key="navigationItem" title="面部翻页" id="FaceRecognizeNav"/>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="FaceRecognizeFirst" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="134" y="803"/>
        </scene>
    </scenes>
    <resources>
        <systemColor name="systemBackgroundColor">
            <color red="1" green="1" blue="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
        </systemColor>
    </resources>
</document>